{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/customer/orders.html",
            "title": "Customer order tracking page",
            "description": "Tracking list should provide status filter, orders table, and details links.",
            "points": 10,
            "requiredElements": ["h1", "form", "select", "table", "th", "td", "a"],
            "requiredIdentifiers": ["customer-hub", "customer-filter-form", "data-table"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/customer/order_detail.html",
            "title": "Customer order detail tracking view",
            "description": "Order detail should show status, total, and placed timestamp fields.",
            "points": 8,
            "requiredElements": ["h1", "dl", "dt", "dd", "a"],
            "requiredIdentifiers": ["customer-hub", "customer-profile-dl", "page-title"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Tracking UI selectors",
            "description": "Styles should include filter form, badges, profile list, and data table for tracking screens.",
            "points": 10,
            "requiredSelectors": [".customer-filter-form", ".data-table", ".badge--ok", ".customer-profile-dl"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_orders_list_redirects_to_login": "Guest Order Tracking Guard",
        "test_customer_orders_list_shows_tracking_columns": "Customer Tracking List Columns",
        "test_customer_orders_status_filter_works": "Customer Status Filter",
        "test_customer_order_detail_displays_status_and_total": "Customer Order Detail Tracking",
        "test_customer_cannot_track_other_customers_order": "Customer Order Access Control",
        "test_admin_and_staff_order_lists_support_status_filter": "Admin and Staff Tracking Filters"
      },
      "descriptions": {
        "test_guest_orders_list_redirects_to_login": "Verifies guests cannot access /customer/orders.",
        "test_customer_orders_list_shows_tracking_columns": "Verifies customer order history page renders status and details columns.",
        "test_customer_orders_status_filter_works": "Verifies customer tracking list accepts status query filter.",
        "test_customer_order_detail_displays_status_and_total": "Verifies customer order detail page shows status, total, and placed info.",
        "test_customer_cannot_track_other_customers_order": "Verifies customers cannot open another customer's order detail.",
        "test_admin_and_staff_order_lists_support_status_filter": "Verifies admin/staff order tracking pages support status filter display."
      },
      "error_messages": {
        "test_guest_orders_list_redirects_to_login": "Guests must be redirected from customer order tracking.",
        "test_customer_orders_list_shows_tracking_columns": "Customer order history must include tracking fields.",
        "test_customer_orders_status_filter_works": "Customer order tracking filter should work.",
        "test_customer_order_detail_displays_status_and_total": "Order detail tracking fields are missing.",
        "test_customer_cannot_track_other_customers_order": "Customers must not track another user's order.",
        "test_admin_and_staff_order_lists_support_status_filter": "Admin/staff tracking screens must support status filter."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Customer opens order tracking list",
          "description": "Login as seeded customer and verify order list with filter controls.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "alice@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/customer/orders']" },
            { "type": "wait", "duration": 1800 }
          ],
          "assertions": [
            { "type": "url", "value": "/customer/orders", "error_message": "Expected /customer/orders" },
            { "type": "visible", "selector": ".customer-hub", "error_message": "Order tracking container missing" },
            { "type": "exists", "selector": "form.customer-filter-form", "error_message": "Status filter form missing" },
            { "type": "exists", "selector": "table.data-table", "error_message": "Order tracking table missing" }
          ]
        },
        {
          "isMandatory": true,
          "name": "Customer opens order detail from tracking list",
          "description": "From orders list, open details link and verify detail page has status and totals.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "alice@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/customer/orders']" },
            { "type": "wait", "duration": 1500 },
            { "type": "click", "selector": "a[href*='/customer/orders/']" },
            { "type": "wait", "duration": 1800 }
          ],
          "assertions": [
            { "type": "url", "value": "/customer/orders/", "error_message": "Expected order detail URL" },
            { "type": "visible", "selector": ".customer-profile-dl", "error_message": "Order detail summary missing" },
            { "type": "exists", "selector": "h1.page-title", "error_message": "Order detail title missing" }
          ]
        }
      ]
    }
  }
}
