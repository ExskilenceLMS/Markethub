{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/customer/dashboard.html",
            "title": "Customer dashboard layout",
            "description": "My account hub shows profile card and navigation to categories and products.",
            "points": 10,
            "requiredElements": ["h1", "h2", "nav", "dl", "dt", "dd"],
            "requiredIdentifiers": ["customer-hub", "customer-profile-card", "customer-hub__nav"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/customer/products.html",
            "title": "Customer catalog and filter",
            "description": "Products page provides GET filter by category and a product card grid.",
            "points": 8,
            "requiredElements": ["form", "select", "ul", "li", "header"],
            "requiredIdentifiers": ["customer-hub", "customer-filter-form", "customer-product-grid"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Customer hub and catalog styles",
            "description": "Styling for customer dashboard, profile, category tiles, filters, and product cards.",
            "points": 10,
            "requiredSelectors": [".customer-hub", ".customer-profile-card", ".customer-product-card", ".customer-filter-form"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_customer_dashboard_redirects_to_login": "Guest Blocked From Customer",
        "test_customer_dashboard_shows_profile_and_shop_nav": "Customer Dashboard Content",
        "test_customer_categories_page_renders_for_customer": "Customer Categories Page",
        "test_customer_products_page_renders_catalog": "Customer Products Catalog",
        "test_customer_login_redirects_to_customer_home": "Customer Login Redirect",
        "test_non_customer_blocked_from_customer_routes": "Non-Customer Blocked"
      },
      "descriptions": {
        "test_guest_customer_dashboard_redirects_to_login": "Verifies GET /customer/ without session returns 302 to the web login route.",
        "test_customer_dashboard_shows_profile_and_shop_nav": "Verifies a logged-in customer sees My account, profile card, and links to categories and products.",
        "test_customer_categories_page_renders_for_customer": "Verifies GET /customer/categories returns the customer hub and category grid or empty state.",
        "test_customer_products_page_renders_catalog": "Verifies GET /customer/products shows the filter form and lists seeded-style products when they exist.",
        "test_customer_login_redirects_to_customer_home": "Verifies POST /login as customer returns 302 to /customer.",
        "test_non_customer_blocked_from_customer_routes": "Verifies a seller hitting /customer/ is redirected to login (role guard)."
      },
      "error_messages": {
        "test_guest_customer_dashboard_redirects_to_login": "Guests must not access the customer dashboard.",
        "test_customer_dashboard_shows_profile_and_shop_nav": "Customer dashboard must show profile and shop navigation.",
        "test_customer_categories_page_renders_for_customer": "Customers must open the categories browse page.",
        "test_customer_products_page_renders_catalog": "Customers must see the catalog filter and product list.",
        "test_customer_login_redirects_to_customer_home": "Customer login must land on the customer home path.",
        "test_non_customer_blocked_from_customer_routes": "Only customers may use customer routes."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Customer login opens My account dashboard",
          "description": "Uses seed customer alice@example.com / user123 (database/seed_data.sql); expects /customer with profile hub.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer",
              "error_message": "Expected redirect to /customer"
            },
            {
              "type": "visible",
              "selector": ".customer-hub",
              "error_message": "Customer hub not visible"
            },
            {
              "type": "visible",
              "selector": ".customer-profile-card",
              "error_message": "Profile card not visible"
            },
            {
              "type": "exists",
              "selector": ".customer-hub__nav a[href*='/customer/categories']",
              "error_message": "Categories nav link missing"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Customer opens All products from dashboard",
          "description": "After customer login, opens the All products card and sees the catalog filter (seed data).",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a[href*='/customer/products']"
            },
            {
              "type": "wait",
              "duration": 2000
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer/products",
              "error_message": "Expected /customer/products"
            },
            {
              "type": "visible",
              "selector": ".customer-filter-form",
              "error_message": "Category filter form not visible"
            },
            {
              "type": "exists",
              "selector": "select[name='category_id']",
              "error_message": "Category filter select missing"
            }
          ]
        }
      ]
    }
  }
}
