{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/customer/cart.html",
            "title": "Cart page structure",
            "description": "Cart shows hub layout, line table or empty state, qty forms, and total or browse link.",
            "points": 10,
            "requiredElements": ["header", "h1", "form", "table", "th", "td", "button"],
            "requiredIdentifiers": ["customer-hub", "customer-cart-card", "customer-cart__total"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/customer/products.html",
            "title": "Add-to-cart on product cards",
            "description": "Each product card posts product_id and quantity to the cart add endpoint.",
            "points": 8,
            "requiredElements": ["form", "input", "button", "label", "ul", "li"],
            "requiredIdentifiers": ["customer-product-card__cart-form", "customer-cart__qty-input"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Cart and add-to-cart styles",
            "description": "Styles for cart card, quantity inputs, product card cart row, and total.",
            "points": 10,
            "requiredSelectors": [".customer-cart-card", ".customer-product-card__cart-form", ".customer-cart__total", ".customer-cart__qty-input"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_cart_redirects_to_login": "Guest Cart Blocked",
        "test_customer_cart_page_renders_when_empty": "Empty Cart Page",
        "test_cart_add_post_redirects_to_products": "Add To Cart Redirect",
        "test_cart_add_merges_quantity_same_product": "Cart Merge Same Product",
        "test_cart_update_line_reflects_in_total": "Update Line Total",
        "test_cart_clear_empties_cart": "Clear Cart"
      },
      "descriptions": {
        "test_guest_cart_redirects_to_login": "Verifies GET /customer/cart without a customer session redirects to web login.",
        "test_customer_cart_page_renders_when_empty": "Verifies a logged-in customer sees the cart page and empty-state messaging when there are no lines.",
        "test_cart_add_post_redirects_to_products": "Verifies POST /customer/cart/add responds with a redirect to the products catalog.",
        "test_cart_add_merges_quantity_same_product": "Verifies repeated adds for the same product_id increase quantity on one cart row and total matches.",
        "test_cart_update_line_reflects_in_total": "Verifies POST /customer/cart/<id>/update changes quantity and the rendered total updates.",
        "test_cart_clear_empties_cart": "Verifies POST /customer/cart/clear removes all lines and the page shows the empty cart message."
      },
      "error_messages": {
        "test_guest_cart_redirects_to_login": "Guests must be redirected from the cart route.",
        "test_customer_cart_page_renders_when_empty": "Empty cart must render for customers.",
        "test_cart_add_post_redirects_to_products": "Add to cart must redirect to products.",
        "test_cart_add_merges_quantity_same_product": "Same product adds must merge into one line.",
        "test_cart_update_line_reflects_in_total": "Cart line update must refresh totals.",
        "test_cart_clear_empties_cart": "Clear cart must remove all items."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Customer opens cart from navbar",
          "description": "Seed customer alice@example.com / user123; after login, Cart nav opens /customer/cart with hub layout.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": ".nav-links > li:nth-child(3) a"
            },
            {
              "type": "wait",
              "duration": 2000
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer/cart",
              "error_message": "Expected cart URL"
            },
            {
              "type": "visible",
              "selector": ".customer-hub",
              "error_message": "Customer hub not visible"
            },
            {
              "type": "exists",
              "selector": "h1.page-title",
              "error_message": "Cart page title missing"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Add product to cart from catalog",
          "description": "Logs in as alice, opens Shop then All products, submits first Add to cart, then opens Cart and sees total row.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": ".nav-links > li:nth-child(2) a"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a[href*='/customer/products']"
            },
            {
              "type": "wait",
              "duration": 2000
            },
            {
              "type": "click",
              "selector": "form.customer-product-card__cart-form button[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2000
            },
            {
              "type": "click",
              "selector": ".nav-links > li:nth-child(3) a"
            },
            {
              "type": "wait",
              "duration": 2000
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer/cart",
              "error_message": "Expected cart after add"
            },
            {
              "type": "visible",
              "selector": ".customer-cart-card",
              "error_message": "Cart card with lines not visible"
            },
            {
              "type": "exists",
              "selector": "p.customer-cart__total",
              "error_message": "Cart total line missing"
            }
          ]
        }
      ]
    }
  }
}
