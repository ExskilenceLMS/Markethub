{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/auth/login.html",
            "title": "Login page structure",
            "description": "Login UI extends base, uses auth layout, POST form with email and password, primary submit, and cross-link to register.",
            "points": 10,
            "requiredElements": ["form", "input", "button", "label"],
            "requiredIdentifiers": ["auth-page", "auth-card", "btn-primary-fk"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/auth/register.html",
            "title": "Register page structure",
            "description": "Registration UI includes name, email, password, confirm password, role control, and link back to login.",
            "points": 10,
            "requiredElements": ["form", "input", "select", "label", "button"],
            "requiredIdentifiers": ["auth-page", "auth-card", "confirm_password"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Auth theme styles",
            "description": "Flipkart-style auth page, card, primary button, and footer link styling for registration and login.",
            "points": 10,
            "requiredSelectors": [".auth-page", ".auth-card", ".btn-primary-fk", ".auth-footer-link"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 45000,
      "points": 45,
      "runTests": {
        "test_login_page_renders_auth_form_and_register_link": "Login Page UI",
        "test_register_page_renders_confirm_password_and_role_select": "Register Page UI",
        "test_login_post_invalid_password_shows_error_message": "Login Error Display",
        "test_register_post_password_mismatch_shows_validation": "Register Password Mismatch",
        "test_register_non_customer_role_shows_role_error": "Register Non-Customer Rejected",
        "test_register_customer_web_post_redirects_to_customer_area": "Customer Register Redirect"
      },
      "descriptions": {
        "test_login_page_renders_auth_form_and_register_link": "Verifies GET /login serves auth-page/auth-card, POST form fields email and password, btn-primary-fk, and a register link.",
        "test_register_page_renders_confirm_password_and_role_select": "Verifies GET /register includes confirm_password, role select, and full registration fields inside auth layout.",
        "test_login_post_invalid_password_shows_error_message": "After seeding a user, POST /login with wrong password returns 200 with form-errors and the generic invalid credentials message.",
        "test_register_post_password_mismatch_shows_validation": "POST /register with different password and confirm_password returns 200 with Passwords do not match and confirm field error markup.",
        "test_register_non_customer_role_shows_role_error": "POST /register with role seller returns 200 with validation UI (customer-only self-registration).",
        "test_register_customer_web_post_redirects_to_customer_area": "POST /register with valid customer data returns 302 to /customer per role-based redirect."
      },
      "error_messages": {
        "test_login_page_renders_auth_form_and_register_link": "Login page must render the auth card and email/password form.",
        "test_register_page_renders_confirm_password_and_role_select": "Register page must include confirm password and role selection.",
        "test_login_post_invalid_password_shows_error_message": "Invalid login must show the error summary without exposing whether the email exists.",
        "test_register_post_password_mismatch_shows_validation": "Mismatched passwords must surface validation on the register page.",
        "test_register_non_customer_role_shows_role_error": "Non-customer self-registration must be rejected in the UI.",
        "test_register_customer_web_post_redirects_to_customer_area": "Successful customer registration must redirect to the customer home path."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Login page auth card and form",
          "description": "Login route shows auth card, POST form, email and password inputs, and link to create an account.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [],
          "assertions": [
            {
              "type": "url",
              "value": "/login",
              "error_message": "Expected /login"
            },
            {
              "type": "visible",
              "selector": ".auth-card",
              "error_message": "Auth card not visible"
            },
            {
              "type": "exists",
              "selector": "form[method='post'] input[name='email']",
              "error_message": "Email field not found"
            },
            {
              "type": "exists",
              "selector": "form[method='post'] input[name='password']",
              "error_message": "Password field not found"
            },
            {
              "type": "visible",
              "selector": "button.btn-primary-fk[type='submit']",
              "error_message": "Primary submit button not found"
            },
            {
              "type": "visible",
              "selector": ".auth-footer-link a[href*='register']",
              "error_message": "Register link not visible"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Register page form structure",
          "description": "Register route shows auth card, confirm password, role select, and login cross-link.",
          "path": "/register",
          "captureScreenshot": true,
          "actions": [],
          "assertions": [
            {
              "type": "url",
              "value": "/register",
              "error_message": "Expected /register"
            },
            {
              "type": "visible",
              "selector": ".auth-card",
              "error_message": "Register auth card not visible"
            },
            {
              "type": "exists",
              "selector": "input[name='confirm_password']",
              "error_message": "Confirm password field not found"
            },
            {
              "type": "exists",
              "selector": "select[name='role']",
              "error_message": "Role select not found"
            },
            {
              "type": "visible",
              "selector": ".auth-footer-link a[href*='login']",
              "error_message": "Log in link not visible"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Register logout and login to customer home",
          "description": "Creates a customer via the register form, logs out, logs in with the same credentials, and lands on /customer (matches pytest credentials pattern).",
          "path": "/register",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='name']",
              "value": "Task Five Browser"
            },
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "task5browser@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "Task5Dyn!pass"
            },
            {
              "type": "fill",
              "selector": "input[name='confirm_password']",
              "value": "Task5Dyn!pass"
            },
            {
              "type": "fill",
              "selector": "select[name='role']",
              "value": "customer"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2000
            },
            {
              "type": "click",
              "selector": "a[href*='logout']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a[href*='login']"
            },
            {
              "type": "wait",
              "duration": 1000
            },
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "task5browser@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "Task5Dyn!pass"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer",
              "error_message": "Expected /customer after login"
            },
            {
              "type": "visible",
              "selector": "main",
              "error_message": "Main not visible after login"
            }
          ]
        }
      ]
    }
  }
}
