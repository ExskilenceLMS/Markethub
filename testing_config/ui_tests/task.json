{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/customer/products.html",
            "title": "Product stock and cart quantity controls",
            "description": "Customer catalog must show stock text, quantity input, and add-to-cart form controls.",
            "points": 10,
            "requiredElements": ["ul", "li", "form", "input", "label", "button", "p"],
            "requiredIdentifiers": ["customer-product-grid", "customer-product-card__qty", "customer-cart__qty-input", "customer-product-card__cart-form"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/customer/cart.html",
            "title": "Cart place-order and quantity update controls",
            "description": "Cart should include line quantity update form, total row, and place-order action.",
            "points": 8,
            "requiredElements": ["table", "form", "input", "button", "p"],
            "requiredIdentifiers": ["customer-cart__qty-form", "customer-cart__total", "customer-cart__place-row"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Inventory-related customer selectors",
            "description": "CSS must include selectors for stock display, qty input, place-order row, and cart card.",
            "points": 10,
            "requiredSelectors": [".customer-product-card__qty", ".customer-cart__qty-input", ".customer-cart__place-row", ".customer-cart-card"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_cannot_access_cart": "Guest Cart Access Guard",
        "test_place_order_reduces_stock_and_clears_cart": "Stock Deduction On Order",
        "test_place_order_blocks_when_quantity_exceeds_stock": "Oversell Prevention",
        "test_product_service_rejects_negative_stock_quantity": "Negative Quantity Validation",
        "test_customer_products_page_shows_stock_and_qty_input": "Stock Display On Catalog",
        "test_cart_update_quantity_rejects_zero": "Cart Quantity Zero Rejected"
      },
      "descriptions": {
        "test_guest_cannot_access_cart": "Verifies unauthenticated users cannot access customer cart routes.",
        "test_place_order_reduces_stock_and_clears_cart": "Verifies placing an order decrements product stock, creates an order, and clears cart lines.",
        "test_place_order_blocks_when_quantity_exceeds_stock": "Verifies order placement is blocked when requested cart quantity exceeds stock.",
        "test_product_service_rejects_negative_stock_quantity": "Verifies product creation rejects negative inventory quantities.",
        "test_customer_products_page_shows_stock_and_qty_input": "Verifies products page renders stock labels and quantity input controls for add-to-cart.",
        "test_cart_update_quantity_rejects_zero": "Verifies cart line update rejects zero quantity and preserves existing line quantity."
      },
      "error_messages": {
        "test_guest_cannot_access_cart": "Guests must be redirected from customer cart.",
        "test_place_order_reduces_stock_and_clears_cart": "Order placement must deduct stock and clear cart.",
        "test_place_order_blocks_when_quantity_exceeds_stock": "System must prevent overselling beyond available stock.",
        "test_product_service_rejects_negative_stock_quantity": "Negative stock quantity must be rejected.",
        "test_customer_products_page_shows_stock_and_qty_input": "Products page must show stock and quantity controls.",
        "test_cart_update_quantity_rejects_zero": "Cart updates must reject zero quantity values."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Customer catalog shows stock and qty control",
          "description": "Logs in as seeded customer and checks inventory display controls on products catalog.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "alice@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/customer/products']" },
            { "type": "wait", "duration": 1800 }
          ],
          "assertions": [
            { "type": "url", "value": "/customer/products", "error_message": "Expected /customer/products" },
            { "type": "visible", "selector": ".customer-product-grid", "error_message": "Product grid not visible" },
            { "type": "exists", "selector": ".customer-product-card__qty", "error_message": "Stock label missing" },
            { "type": "exists", "selector": "input.customer-cart__qty-input", "error_message": "Quantity input missing" }
          ]
        },
        {
          "isMandatory": true,
          "name": "Customer places order after adding cart line",
          "description": "Adds product to cart and places order, then verifies redirect to customer orders list.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "alice@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/customer/products']" },
            { "type": "wait", "duration": 1500 },
            { "type": "click", "selector": "form.customer-product-card__cart-form button[type='submit']" },
            { "type": "wait", "duration": 1500 },
            { "type": "click", "selector": "a[href='/customer/cart']" },
            { "type": "wait", "duration": 1500 },
            { "type": "click", "selector": "form.customer-cart__place-row button[type='submit']" },
            { "type": "wait", "duration": 2200 }
          ],
          "assertions": [
            { "type": "url", "value": "/customer/orders", "error_message": "Expected redirect to /customer/orders" },
            { "type": "visible", "selector": ".customer-hub", "error_message": "Orders page container missing" },
            { "type": "exists", "selector": "table.data-table", "error_message": "Orders table not rendered" }
          ]
        }
      ]
    }
  }
}
