{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/base.html",
            "title": "Base layout document structure",
            "description": "Base template must define the HTML shell, linked stylesheet, main landmark, and include slots for chrome.",
            "points": 10,
            "requiredElements": ["html", "head", "body", "main"],
            "error_message": "{requiredElements} not found"
          },
          {
            "file": "templates/auth/login.html",
            "title": "Login page form and card",
            "description": "Login template extends base and exposes a POST form with email and password plus primary actions.",
            "points": 10,
            "requiredElements": ["form", "input", "button", "label"],
            "requiredIdentifiers": ["card", "btn"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/base.css",
            "title": "Base layout and component styles",
            "description": "Global layout styles for header, footer, main content, cards, and buttons.",
            "points": 10,
            "requiredSelectors": [".site-header", ".site-footer", "main", ".card", ".btn"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 45000,
      "points": 40,
      "runTests": {
        "test_home_page_includes_header_main_footer_layout": "Home Uses Base Layout",
        "test_login_page_has_post_form_email_password": "Login Page Form Structure",
        "test_register_page_inherits_layout_and_flash_slot": "Register Page Layout",
        "test_web_login_success_redirects_to_home": "Web Login Redirects Home"
      },
      "descriptions": {
        "test_home_page_includes_header_main_footer_layout": "Verifies GET / returns 200 and HTML containing site-header, main, site-footer, and base.css link.",
        "test_login_page_has_post_form_email_password": "Verifies GET /login returns 200 with POST form, email/password fields, submit button, navbar, and register link.",
        "test_register_page_inherits_layout_and_flash_slot": "Verifies GET /register returns 200 with customer registration form, shared chrome, hidden customer role, and that base.html includes the flash_messages partial.",
        "test_web_login_success_redirects_to_home": "Registers a customer via POST /register, logs out, then POST /login with the same credentials returns 302 to home (not login)."
      },
      "error_messages": {
        "test_home_page_includes_header_main_footer_layout": "Home page must render the shared layout (header, main, footer) and link base.css.",
        "test_login_page_has_post_form_email_password": "Login page must expose a POST form with email and password fields.",
        "test_register_page_inherits_layout_and_flash_slot": "Register page must use the base layout, customer role field, and base template must include flash_messages.",
        "test_web_login_success_redirects_to_home": "Valid web form login must redirect to the home route."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Home page base layout visible",
          "description": "Home should show navbar, main content, and footer from the base layout.",
          "path": "/",
          "captureScreenshot": true,
          "actions": [],
          "assertions": [
            {
              "type": "url",
              "value": "/",
              "error_message": "Expected home URL /"
            },
            {
              "type": "visible",
              "selector": ".site-header",
              "error_message": "Site header not visible"
            },
            {
              "type": "exists",
              "selector": "main .page-title",
              "error_message": "Main page title not found"
            },
            {
              "type": "visible",
              "selector": ".site-footer",
              "error_message": "Footer not visible"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Login page form structure",
          "description": "Login page must expose POST form with email and password and link to register.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [],
          "assertions": [
            {
              "type": "visible",
              "selector": "form[method='post']",
              "error_message": "Login POST form not found"
            },
            {
              "type": "exists",
              "selector": "input[name='email']",
              "error_message": "Email input not found"
            },
            {
              "type": "exists",
              "selector": "input[name='password']",
              "error_message": "Password input not found"
            },
            {
              "type": "visible",
              "selector": "button[type='submit']",
              "error_message": "Submit button not found"
            },
            {
              "type": "visible",
              "selector": "a[href*='register']",
              "error_message": "Register link not found"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Register logout and web login to home",
          "description": "Creates a customer via the register form, logs out, then logs in with the same email and password and reaches home (matches server-side session flow).",
          "path": "/register",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='name']",
              "value": "Playwright Task4"
            },
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "task4playwright@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "Task4Test!pass"
            },
            {
              "type": "click",
              "selector": "button[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2000
            },
            {
              "type": "click",
              "selector": "a[href*='logout']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a[href*='login']"
            },
            {
              "type": "wait",
              "duration": 1000
            },
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "task4playwright@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "Task4Test!pass"
            },
            {
              "type": "click",
              "selector": "button[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2000
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/",
              "error_message": "Expected redirect to home / after login"
            },
            {
              "type": "visible",
              "selector": "main .page-title",
              "error_message": "Home page title not visible after login"
            }
          ]
        }
      ]
    }
  }
}
