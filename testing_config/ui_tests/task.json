{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/admin/category_form.html",
            "title": "Admin category structured form",
            "description": "Category create/edit uses form-card, POST form, name input, optional description textarea, and save control.",
            "points": 10,
            "requiredElements": ["form", "input", "textarea", "label", "button"],
            "requiredIdentifiers": ["form-card", "name", "description"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/admin/store_form.html",
            "title": "Admin store structured form",
            "description": "Store form includes name, seller select, category checkbox grid, and active toggle.",
            "points": 10,
            "requiredElements": ["form", "select", "fieldset", "input", "label"],
            "requiredIdentifiers": ["form-card", "seller_id", "checkbox-grid"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Form and checkbox layout styles",
            "description": "Structured admin forms use form-card, checkbox grid, and checkbox labels.",
            "points": 10,
            "requiredSelectors": [".form-card", ".checkbox-grid", ".checkbox-label", ".form-label-block"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_admin_category_new_get_renders_form_fields": "Category Form GET",
        "test_admin_category_post_creates_and_redirects_to_list": "Category Create Redirect",
        "test_admin_category_post_empty_name_shows_validation_ui": "Category Validation UI",
        "test_admin_store_new_get_renders_seller_select_and_category_grid": "Store Form GET",
        "test_admin_store_post_creates_and_redirects_to_store_list": "Store Create Redirect",
        "test_seller_staff_stores_readonly_page_loads": "Seller Stores Read-Only"
      },
      "descriptions": {
        "test_admin_category_new_get_renders_form_fields": "Verifies an admin session receives the category new page with form-card, name, description textarea, and POST form.",
        "test_admin_category_post_creates_and_redirects_to_list": "Verifies POST /admin/categories/new with valid data returns 302 to /admin/categories and the new row appears on the list.",
        "test_admin_category_post_empty_name_shows_validation_ui": "Verifies empty name re-renders the form with Category name is required and error partials.",
        "test_admin_store_new_get_renders_seller_select_and_category_grid": "Verifies store new page includes seller_id select, category_ids checkboxes in checkbox-grid, and is_active toggle.",
        "test_admin_store_post_creates_and_redirects_to_store_list": "Verifies POST /admin/stores/new with seller and category redirects to /admin/stores and lists the store.",
        "test_seller_staff_stores_readonly_page_loads": "Verifies a seller can GET /staff/stores and see the read-only stores UI."
      },
      "error_messages": {
        "test_admin_category_new_get_renders_form_fields": "Admin category form must expose structured fields.",
        "test_admin_category_post_creates_and_redirects_to_list": "Valid category submission must redirect to the category list.",
        "test_admin_category_post_empty_name_shows_validation_ui": "Invalid category input must show validation in the template.",
        "test_admin_store_new_get_renders_seller_select_and_category_grid": "Store form must include seller and category controls.",
        "test_admin_store_post_creates_and_redirects_to_store_list": "Valid store submission must redirect to the store list.",
        "test_seller_staff_stores_readonly_page_loads": "Seller must access the staff stores read-only page."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Admin navigates to category form",
          "description": "Logs in with seed admin@example.com / user123 (database/seed_data.sql), opens Categories, then Add category, and sees structured fields.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "admin@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a.admin-sidebar__link[href$='/categories']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a.btn-primary-fk[href*='categories/new']"
            },
            {
              "type": "wait",
              "duration": 1200
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/admin/categories/new",
              "error_message": "Expected category new URL"
            },
            {
              "type": "visible",
              "selector": ".form-card form[method='post']",
              "error_message": "Category POST form not visible"
            },
            {
              "type": "exists",
              "selector": "input[name='name']",
              "error_message": "Category name input missing"
            },
            {
              "type": "exists",
              "selector": "textarea[name='description']",
              "error_message": "Description textarea missing"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Admin store form structured controls",
          "description": "From admin dashboard, opens Stores then Add store and verifies seller select and category checkbox grid (seed data).",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "admin@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a.admin-sidebar__link[href$='/stores']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a.btn-primary-fk[href*='stores/new']"
            },
            {
              "type": "wait",
              "duration": 1200
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/admin/stores/new",
              "error_message": "Expected store new URL"
            },
            {
              "type": "exists",
              "selector": "select[name='seller_id']",
              "error_message": "Seller select missing"
            },
            {
              "type": "visible",
              "selector": ".checkbox-grid",
              "error_message": "Category checkbox grid not visible"
            },
            {
              "type": "exists",
              "selector": "input[name='name']",
              "error_message": "Store name input missing"
            }
          ]
        }
      ]
    }
  }
}
