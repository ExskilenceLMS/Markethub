{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/customer/orders.html",
            "title": "Customer orders list layout",
            "description": "Orders page should render heading, table columns, status and detail link structure.",
            "points": 10,
            "requiredElements": ["h1", "table", "thead", "tbody", "th", "td", "a"],
            "requiredIdentifiers": ["customer-hub", "data-card", "data-table"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/admin/order_detail.html",
            "title": "Admin order detail status form",
            "description": "Admin detail must provide status summary and update form with status select.",
            "points": 8,
            "requiredElements": ["h1", "dl", "dt", "dd", "form", "select", "button"],
            "requiredIdentifiers": ["customer-profile-dl", "form-card", "btn-primary-fk"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Order-related selectors",
            "description": "Order pages reuse profile list, badges and order placement cart row styles.",
            "points": 10,
            "requiredSelectors": [".customer-profile-dl", ".badge--ok", ".customer-cart__place-row", ".data-table"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_orders_redirects_to_login": "Guest Orders Blocked",
        "test_place_order_from_cart_redirects_and_persists_order": "Place Order From Cart",
        "test_place_order_empty_cart_redirects_back_to_cart": "Empty Cart Place Order Guard",
        "test_customer_orders_list_renders_placed_order": "Customer Orders Listing",
        "test_customer_cannot_view_other_customers_order_detail": "Order Detail Access Control",
        "test_admin_updates_order_status_to_shipped": "Admin Status Update"
      },
      "descriptions": {
        "test_guest_orders_redirects_to_login": "Verifies unauthenticated users are redirected from /customer/orders to /login.",
        "test_place_order_from_cart_redirects_and_persists_order": "Verifies placing order from a populated cart creates one Placed order, clears cart, and decrements product stock.",
        "test_place_order_empty_cart_redirects_back_to_cart": "Verifies place-order from an empty cart redirects back to /customer/cart and does not create an order.",
        "test_customer_orders_list_renders_placed_order": "Verifies /customer/orders renders the created order id and status in the listing.",
        "test_customer_cannot_view_other_customers_order_detail": "Verifies customer authorization guard on /customer/orders/<id>.",
        "test_admin_updates_order_status_to_shipped": "Verifies admin can change status from Placed to Shipped via /admin/orders/<id>."
      },
      "error_messages": {
        "test_guest_orders_redirects_to_login": "Guests must not access customer orders routes.",
        "test_place_order_from_cart_redirects_and_persists_order": "Place-order must persist order, clear cart, and adjust stock.",
        "test_place_order_empty_cart_redirects_back_to_cart": "Empty cart place-order must redirect to cart and avoid order creation.",
        "test_customer_orders_list_renders_placed_order": "Orders list should show newly placed order details.",
        "test_customer_cannot_view_other_customers_order_detail": "Customers should not view other customers' orders.",
        "test_admin_updates_order_status_to_shipped": "Admin status update should persist new order state."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Customer opens Orders page",
          "description": "Login with seeded customer and confirm Orders page structure is visible.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a[href*='/customer/orders']"
            },
            {
              "type": "wait",
              "duration": 1800
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer/orders",
              "error_message": "Expected /customer/orders"
            },
            {
              "type": "visible",
              "selector": ".customer-hub",
              "error_message": "Customer orders container not visible"
            },
            {
              "type": "exists",
              "selector": "h1.page-title",
              "error_message": "Orders page title missing"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Customer places order from cart",
          "description": "Login, open products, add one item to cart, place order, and verify redirection to orders listing.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "alice@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a[href='/customer/products']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "form.customer-product-card__cart-form button[type='submit']"
            },
            {
              "type": "wait",
              "duration": 1800
            },
            {
              "type": "click",
              "selector": "a[href='/customer/cart']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "form.customer-cart__place-row button[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2200
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/customer/orders",
              "error_message": "Expected redirect to orders after place-order"
            },
            {
              "type": "visible",
              "selector": ".data-card",
              "error_message": "Orders card not visible"
            },
            {
              "type": "exists",
              "selector": "table.data-table",
              "error_message": "Orders table missing after placing order"
            }
          ]
        }
      ]
    }
  }
}
