{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/admin/order_detail.html",
            "title": "Admin workflow control UI",
            "description": "Admin order detail must show status summary and update-status select workflow.",
            "points": 10,
            "requiredElements": ["h1", "dl", "dt", "dd", "form", "select", "button"],
            "requiredIdentifiers": ["form-card", "customer-profile-dl", "btn-primary-fk"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/staff/order_detail.html",
            "title": "Staff workflow control UI",
            "description": "Staff order detail should provide controlled status update form with same workflow semantics.",
            "points": 8,
            "requiredElements": ["h1", "dl", "form", "select", "button", "label"],
            "requiredIdentifiers": ["staff-hub", "form-card", "customer-profile-dl"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Order workflow selectors",
            "description": "Order UI workflow screens require data table, badges, profile list and form-card styling.",
            "points": 10,
            "requiredSelectors": [".form-card", ".badge--ok", ".customer-profile-dl", ".customer-filter-form"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_guest_cannot_open_admin_order_detail": "Guest Blocked From Admin Workflow",
        "test_admin_order_detail_shows_status_control_ui": "Admin Status Control UI",
        "test_admin_can_transition_order_placed_to_shipped": "Admin Valid Status Transition",
        "test_staff_invalid_transition_is_blocked": "Staff Invalid Transition Blocked",
        "test_customer_cannot_post_status_update_to_order_routes": "Customer Cannot Update Status",
        "test_status_filter_controls_exist_on_admin_and_staff_lists": "Admin Staff Filter UI"
      },
      "descriptions": {
        "test_guest_cannot_open_admin_order_detail": "Verifies guests cannot access admin order workflow route.",
        "test_admin_order_detail_shows_status_control_ui": "Verifies admin order detail page renders status update controls.",
        "test_admin_can_transition_order_placed_to_shipped": "Verifies admin can execute valid transition from Placed to Shipped.",
        "test_staff_invalid_transition_is_blocked": "Verifies staff cannot jump directly from Placed to Delivered.",
        "test_customer_cannot_post_status_update_to_order_routes": "Verifies customer role cannot post status updates to staff/admin routes.",
        "test_status_filter_controls_exist_on_admin_and_staff_lists": "Verifies status filter controls are present on admin and staff order lists."
      },
      "error_messages": {
        "test_guest_cannot_open_admin_order_detail": "Guests must not access admin order detail workflow.",
        "test_admin_order_detail_shows_status_control_ui": "Admin status control UI is missing.",
        "test_admin_can_transition_order_placed_to_shipped": "Admin valid workflow transition failed.",
        "test_staff_invalid_transition_is_blocked": "Invalid staff status transition should be blocked.",
        "test_customer_cannot_post_status_update_to_order_routes": "Customers should not update order statuses on admin/staff routes.",
        "test_status_filter_controls_exist_on_admin_and_staff_lists": "Status filter UI missing on admin/staff order lists."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Admin opens order list workflow controls",
          "description": "Login as seeded admin and verify order list status filter exists.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "admin@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/admin/orders']" },
            { "type": "wait", "duration": 1800 }
          ],
          "assertions": [
            { "type": "url", "value": "/admin/orders", "error_message": "Expected /admin/orders" },
            { "type": "visible", "selector": "form.customer-filter-form", "error_message": "Status filter form missing" },
            { "type": "exists", "selector": "table.data-table", "error_message": "Order list table missing" }
          ]
        },
        {
          "isMandatory": true,
          "name": "Admin opens order detail status workflow",
          "description": "From admin orders list, open order detail and verify status select + save controls.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            { "type": "fill", "selector": "input[name='email']", "value": "admin@example.com" },
            { "type": "fill", "selector": "input[name='password']", "value": "user123" },
            { "type": "click", "selector": "button.btn-primary-fk[type='submit']" },
            { "type": "wait", "duration": 2500 },
            { "type": "click", "selector": "a[href='/admin/orders']" },
            { "type": "wait", "duration": 1500 },
            { "type": "click", "selector": "a[href*='/admin/orders/']" },
            { "type": "wait", "duration": 1800 }
          ],
          "assertions": [
            { "type": "url", "value": "/admin/orders/", "error_message": "Expected admin order detail URL" },
            { "type": "visible", "selector": "div.form-card", "error_message": "Workflow form card missing" },
            { "type": "exists", "selector": "select#status[name='status']", "error_message": "Status select control missing" },
            { "type": "exists", "selector": "button.btn-primary-fk[type='submit']", "error_message": "Save button missing" }
          ]
        }
      ]
    }
  }
}
