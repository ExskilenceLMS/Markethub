{
  "id": "task",
  "validation": {
    "minScore": 70,
    "static": {
      "required": true,
      "html": {
        "isMandatory": true,
        "rules": [
          {
            "file": "templates/admin/product_form.html",
            "title": "Admin product CRUD form",
            "description": "Admin product create/edit includes name, pricing, quantity, category, seller assignment, and optional image URL.",
            "points": 10,
            "requiredElements": ["form", "input", "textarea", "select", "label", "button"],
            "requiredIdentifiers": ["form-card", "category_id", "seller_id", "price"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          },
          {
            "file": "templates/staff/product_form.html",
            "title": "Staff seller product form",
            "description": "Seller-facing product form uses form-card and category select scoped to store-linked categories; no seller_id field.",
            "points": 8,
            "requiredElements": ["form", "input", "textarea", "select", "label", "button"],
            "requiredIdentifiers": ["form-card", "category_id", "staff-hub--wide"],
            "error_message": "{requiredElements} not found",
            "error_message_identifiers": "{requiredIdentifiers} not found"
          }
        ]
      },
      "css": {
        "isMandatory": true,
        "rules": [
          {
            "file": "static/css/style.css",
            "title": "Product list and staff hub styles",
            "description": "Catalog tables and wide staff layout for product management.",
            "points": 8,
            "requiredSelectors": [".data-table", ".data-card", ".form-card", ".staff-hub--wide"],
            "error_message": "{requiredSelectors} not found"
          }
        ]
      }
    },
    "pytest": {
      "required": true,
      "requiresFlask": false,
      "testFile": "testing_config/py_tests/task.py",
      "timeout": 60000,
      "points": 48,
      "runTests": {
        "test_admin_product_new_get_renders_crud_form": "Admin Product Form GET",
        "test_admin_product_create_post_redirects_to_list": "Admin Product Create",
        "test_admin_product_post_empty_name_shows_validation": "Admin Product Validation",
        "test_seller_product_new_get_renders_form_when_store_has_category": "Seller Product Form GET",
        "test_seller_product_create_post_redirects_to_list": "Seller Product Create",
        "test_admin_product_delete_removes_product": "Admin Product Delete"
      },
      "descriptions": {
        "test_admin_product_new_get_renders_crud_form": "Verifies an admin session receives /admin/products/new with form-card and fields name, price, quantity, category_id, seller_id.",
        "test_admin_product_create_post_redirects_to_list": "Verifies POST creates a product, returns 302 to /admin/products, and the name appears on the list.",
        "test_admin_product_post_empty_name_shows_validation": "Verifies empty name returns 200 with Product name is required.",
        "test_seller_product_new_get_renders_form_when_store_has_category": "Verifies a seller with a store linked to a category sees the add-product form without seller_id.",
        "test_seller_product_create_post_redirects_to_list": "Verifies seller POST creates a product and redirects to /staff/products with the new row.",
        "test_admin_product_delete_removes_product": "Verifies admin POST to product delete removes the product from the admin list."
      },
      "error_messages": {
        "test_admin_product_new_get_renders_crud_form": "Admin product form must expose full CRUD fields.",
        "test_admin_product_create_post_redirects_to_list": "Admin must be able to create products and see them listed.",
        "test_admin_product_post_empty_name_shows_validation": "Invalid admin product input must show validation.",
        "test_seller_product_new_get_renders_form_when_store_has_category": "Seller must see the product form when categories exist via stores.",
        "test_seller_product_create_post_redirects_to_list": "Seller must create products for allowed categories.",
        "test_admin_product_delete_removes_product": "Admin must be able to delete a product."
      }
    },
    "dynamic": {
      "required": true,
      "requiresFlask": true,
      "flaskConfig": {
        "appPath": "app.py",
        "port": 5000,
        "startupTimeout": 20000
      },
      "baseUrl": "http://localhost:5000",
      "tests": [
        {
          "isMandatory": true,
          "name": "Admin opens structured product form",
          "description": "Seed admin admin@example.com / user123 (database/seed_data.sql) navigates to Products then Add product.",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "admin@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a.admin-sidebar__link[href$='/products']"
            },
            {
              "type": "wait",
              "duration": 1500
            },
            {
              "type": "click",
              "selector": "a.btn-primary-fk[href*='products/new']"
            },
            {
              "type": "wait",
              "duration": 1200
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/admin/products/new",
              "error_message": "Expected admin product new URL"
            },
            {
              "type": "exists",
              "selector": "input[name='name']",
              "error_message": "Product name field missing"
            },
            {
              "type": "exists",
              "selector": "input[name='price']",
              "error_message": "Price field missing"
            },
            {
              "type": "exists",
              "selector": "select[name='seller_id']",
              "error_message": "Seller select missing for admin"
            },
            {
              "type": "exists",
              "selector": "select[name='category_id']",
              "error_message": "Category select missing"
            }
          ]
        },
        {
          "isMandatory": true,
          "name": "Admin product list page structure",
          "description": "After login, admin Products page shows heading and Add product control (seed data).",
          "path": "/login",
          "captureScreenshot": true,
          "actions": [
            {
              "type": "fill",
              "selector": "input[name='email']",
              "value": "admin@example.com"
            },
            {
              "type": "fill",
              "selector": "input[name='password']",
              "value": "user123"
            },
            {
              "type": "click",
              "selector": "button.btn-primary-fk[type='submit']"
            },
            {
              "type": "wait",
              "duration": 2500
            },
            {
              "type": "click",
              "selector": "a.admin-sidebar__link[href$='/products']"
            },
            {
              "type": "wait",
              "duration": 1500
            }
          ],
          "assertions": [
            {
              "type": "url",
              "value": "/admin/products",
              "error_message": "Expected /admin/products"
            },
            {
              "type": "visible",
              "selector": "h1.page-title",
              "error_message": "Products title not visible"
            },
            {
              "type": "visible",
              "selector": "a.btn-primary-fk[href*='products/new']",
              "error_message": "Add product control not visible"
            },
            {
              "type": "exists",
              "selector": ".data-card",
              "error_message": "Product list container missing"
            }
          ]
        }
      ]
    }
  }
}
